PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_farm_iot
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=2000
SIMULATOR_ACK_TIMEOUT_MS=5000
SIMULATOR_EFFECT_TIMEOUT_MS=5000
TELEMETRY_HISTORY_WINDOW_MINUTES=15
TELEMETRY_HISTORY_POINTS_PER_SERIES=30
TELEMETRY_CHANGE_STREAM=true
# Assumed hours before a farmer notices a silent pump failure without FarmGuard (business-impact KPI)
BASELINE_MANUAL_DETECTION_HOURS=12
# Optional local MQTT demo: docker compose --profile mqtt up -d mqtt
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_TOPIC=farmguard/+/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Real ESP32 hardware (IOT/SmartAgriculture firmware). Listed farms stop being simulated.
# deviceId is the MQTT topic segment: smartgarden/<deviceId>/telemetry
# HARDWARE_DEVICES=garden01=FARM-001
# Broker the ESP32 publishes to (MQTT_BROKER in AppConfig.h). Defaults to MQTT_URL.
# HARDWARE_MQTT_URL=mqtt://192.168.0.132:1883
# HARDWARE_TOPIC_PREFIX=smartgarden
# Relay ON this long without a soil-moisture rise of HARDWARE_MIN_MOISTURE_RISE points -> silent failure
# HARDWARE_EFFECT_WINDOW_MS=60000
# HARDWARE_MIN_MOISTURE_RISE=3
# HARDWARE_STALE_MS=15000
# HARDWARE_ACK_TIMEOUT_MS=8000

# Optional Datadog Agent / DogStatsD configuration
DD_SERVICE=smart-farm-mvp
DD_ENV=development
DD_VERSION=0.1.0
# Datadog trial credentials (Organization Settings > API Keys / Application Keys)
# DD_API_KEY=
# DD_APP_KEY=
# DD_SITE=datadoghq.com   # us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com ... match your trial URL
# Who gets paged by monitors, space separated: @email, @slack-channel, @webhook-name
# DD_ALERT_NOTIFY=@you@example.com
# DD_APM_ENABLED=true
# DD_AGENT_HOST=127.0.0.1
# DD_DOGSTATSD_PORT=8125
# DD_LOG_FILE=./logs/farmguard.jsonl
